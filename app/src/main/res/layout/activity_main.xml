<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CRAZY CAT"
            android:textColor="#00FF41"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v3.1"
            android:textColor="#555555"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Status Card -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/headerLayout"
        android:background="#1A1A2E"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="20dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#FF3333"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Conectando..."
            android:textColor="#AAAAAA"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- Grid de Cards 2x2 -->
    <GridLayout
        android:id="@+id/gridCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/statusCard"
        android:layout_centerVertical="true"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <!-- Card 1: SUB-GHz -->
        <LinearLayout
            android:id="@+id/cardSubGhz"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="#162447"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#1B5E20"
                android:gravity="center"
                android:text="⌅"
                android:textColor="#00FF41"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="SUB-GHz"
                android:textColor="#00FF41"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="433 / 315 / 868 MHz"
                android:textColor="#666666"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Card 2: NRF24 -->
        <LinearLayout
            android:id="@+id/cardNrf24"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="#1F1A2E"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#E65100"
                android:gravity="center"
                android:text="◎"
                android:textColor="#FF9100"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="2.4 GHz"
                android:textColor="#FF9100"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NRF24 Protocol"
                android:textColor="#666666"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Card 3: Bluetooth -->
        <LinearLayout
            android:id="@+id/cardBluetooth"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="#1A1A3E"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#0D47A1"
                android:gravity="center"
                android:text="⦿"
                android:textColor="#42A5F5"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="BLUETOOTH"
                android:textColor="#42A5F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLE Scan & Spam"
                android:textColor="#666666"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Card 4: WiFi -->
        <LinearLayout
            android:id="@+id/cardWifi"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="#2E1A1A"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#B71C1C"
                android:gravity="center"
                android:text="▨"
                android:textColor="#FF5252"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="WI-FI"
                android:textColor="#FF5252"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deauth & Evil Twin"
                android:textColor="#666666"
                android:textSize="10sp"/>
        </LinearLayout>

    </GridLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:text="Crazy Cat · ESP32"
        android:textColor="#333333"
        android:textSize="11sp"/>

</RelativeLayout>
