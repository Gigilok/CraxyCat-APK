<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical"
    android:padding="18dp"
    android:fitsSystemWindows="true">

    <!-- ============ HEADER ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_cat_logo"
            android:background="@drawable/icon_circle_cyan"
            android:padding="3dp"
            android:contentDescription="logo"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRAZY CAT"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.06"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_version"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:background="@drawable/status_pill_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"/>
    </LinearLayout>

    <!-- ============ STATUS PILL ============ -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/status_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginBottom="18dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_connecting"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/status_connecting"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"/>

        <TextView
            android:id="@+id/tvStatusTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP32"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:letterSpacing="0.08"/>
    </LinearLayout>

    <!-- ============ 2x2 GRID - Linha 1 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/cardSubGhz"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_subghz"
                android:background="@drawable/icon_circle_cyan"
                android:padding="6dp"
                android:contentDescription="subghz"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cat_subghz"
                android:textColor="@color/subghz_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/cat_subghz_desc"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:letterSpacing="0.04"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardNrf24"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_nrf24"
                android:background="@drawable/icon_circle_amber"
                android:padding="6dp"
                android:contentDescription="nrf24"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cat_nrf24"
                android:textColor="@color/nrf24_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/cat_nrf24_desc"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:letterSpacing="0.04"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/cardBluetooth"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_bluetooth"
                android:background="@drawable/icon_circle_blue"
                android:padding="6dp"
                android:contentDescription="bt"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cat_bluetooth"
                android:textColor="@color/bluetooth_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/cat_bluetooth_desc"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:letterSpacing="0.04"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardWifi"
            style="@style/CardButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_wifi"
                android:background="@drawable/icon_circle_red"
                android:padding="6dp"
                android:contentDescription="wifi"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cat_wifi"
                android:textColor="@color/wifi_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/cat_wifi_desc"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:letterSpacing="0.04"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardAtaques"
        style="@style/CardButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="18dp"
        android:layout_marginTop="10dp">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_attacks"
            android:background="@drawable/icon_circle_purple"
            android:padding="6dp"
            android:contentDescription="ataques"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_attacks"
                android:textColor="@color/attacks_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cat_attacks_desc"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron"
            android:contentDescription="open"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Crazy Cat · ESP32 · Centro de Controle"
        android:textColor="@color/text_tertiary"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"/>

</LinearLayout>
