                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Ferramenta 5"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnTool6"
                style="@style/ToolListItem"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="36dp"
                    android:background="@color/accent_purple"/>

                <TextView
                    android:id="@+id/tvTool6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Ferramenta 6"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnTool7"
                style="@style/ToolListItem"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="36dp"
                    android:background="@color/accent_cyan"/>

                <TextView
                    android:id="@+id/tvTool7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Ferramenta 7"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnTool8"
                style="@style/ToolListItem"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="36dp"
                    android:background="@color/accent_amber"/>

                <TextView
                    android:id="@+id/tvTool8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Ferramenta 8"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
